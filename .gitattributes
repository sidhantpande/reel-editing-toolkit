workspaces/my-dental-skin-clinic/04_generated_broll/approved/*.mp4 filter=lfs diff=lfs merge=lfs -text
workspaces/my-dental-skin-clinic/00_inbox/brand/*.png filter=lfs diff=lfs merge=lfs -text
workspaces/my-dental-skin-clinic/assets/fonts/**/*.ttf filter=lfs diff=lfs merge=lfs -text
